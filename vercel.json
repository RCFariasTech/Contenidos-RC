{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "/api/index?ruta=:ruta*" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{rc,config,prompts,plantilla}/**"
    }
  },
  "crons": [
    { "path": "/api/diario", "schedule": "17 12 * * *" }
  ]
}
